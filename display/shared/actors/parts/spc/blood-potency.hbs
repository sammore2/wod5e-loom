<div class="flexcol flex-center">
    <span class="resource-label field-header">{{localize 'WOD5E.VTM.BloodPotency'}}</span>
    {{#if locked}}
        <div class="resource stat-resource-background">
            {{bloodpotency}}
        </div>
    {{else}}
        <input type="number" min="0" max="10" data-path="blood.potency" value="{{bloodpotency}}" data-dtype="Number"/>
    {{/if}}
</div>
