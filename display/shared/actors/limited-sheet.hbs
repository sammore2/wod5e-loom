<section>
    <header class="limited-actor-header flex-center">
        <div class="header-content">
            <img class="profile-img" src="{{img}}" title="{{name}}" width="100" alt="Profile Image"/>
            <div class="charname">
                {{name}}
            </div>
        </div>
    </header>
    <hr>
    <section class="sheet-body">
        <section class="tab description-content" data-tab="biography" data-group="primary">
            {{#if settings.limited.biography}}
                <div class="description-field">
                    <div class="flex-center"><span class="resource-label"><h2>{{localize "WOD5E.BiographyList.Label"}}</h2></span></div>
                    <div class="limited-description-body">{{{enrichedBiography}}}</div>
                </div>
            {{/if}}
            {{#if settings.limited.appearance}}
                <div class="description-field">
                    <div class="flex-center"><span class="resource-label"><h2>{{localize "WOD5E.BiographyList.Appearance"}}</h2></span></div>
                    <div class="limited-description-body">{{{enrichedAppearance}}}</div>
                </div>
            {{/if}}
            {{#if settings.limited.touchstones}}
                <div class="description-field">
                    <div class="flex-center"><span class="resource-label"><h2>{{localize "WOD5E.BiographyList.TouchstonesAndConvictions"}}</h2></span></div>
                    <div class="limited-description-body">{{{enrichedTouchstones}}}</div>
                </div>
            {{/if}}
            {{#if settings.limited.tenets}}
                <div class="description-field">
                    <div class="flex-center"><span class="resource-label"><h2>{{localize "WOD5E.BiographyList.ChronicleTenets"}}</h2></span></div>
                    <div class="limited-description-body">{{{enrichedTenets}}}</div>
                </div>
            {{/if}}
        </section>

        <section class="tab description-content" data-tab="notepad" data-group="primary">
            <div class="note-container public-notepad">
                <div class="flex-center"><span class="resource-label field-header">{{localize "WOD5E.Tabs.PublicNotes"}}</span></div>
                <div class="limited-description-body">{{{enrichedNotes}}}</div>
            </div>
        </section>
    </section>
</section>
