<header class="item-header">
    <img class="profile-img" data-action="editImage" src="{{img}}" data-edit="img" title="{{name}}" alt="Item Image" />
    <div class="header-fields">
        {{#if locked}}
            <h1>{{name}}</h1>
        {{else}}
            <input class="itemname" name="name" type="text" value="{{name}}" placeholder="{{localize 'WOD5E.Name'}}"/>
        {{/if}}
        <div class="flexrow flex-center header-details">
            <!-- Select the edge this perk belongs to -->
            <label for="perk-edge-type">
                <b>{{localize "WOD5E.HTR.EdgeType"}}</b>
            </label>
            <select id="perk-edge-type" data-path="edge" data-type="String">
                {{selectOptions edgeOptions selected=selectedEdge localize=true}}
            </select>
        </div>
    </div>
</header>
