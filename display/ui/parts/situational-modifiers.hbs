<div class="situational-modifiers">
  {{#if situationalModifiers}}
    <h3 class="list-title">{{localize 'WOD5E.RollList.SelectableModifiers'}}</h3>
    <div class="mod-row mod-header">
      <div class="col-source">{{localize 'WOD5E.RollList.Source'}}</div>
      <div class="col-value">{{localize 'WOD5E.Value'}}</div>
      <div class="col-active">{{localize 'WOD5E.Modifier.Active'}}</div>
    </div>
    {{#each situationalModifiers as |mod key|}}
      <div class="mod-row modifier">
        <div class="col-source mod-label" title="{{localize mod.source}}">{{localize mod.source}}</div>
        <div class="col-value mod-value">{{mod.value}}</div>
        <div class="col-active mod-active">
          <input type="checkbox" class="mod-checkbox" data-value="{{mod.value}}" data-label="{{localize mod.source}}"
            data-advanced-check-dice="{{mod.advancedCheckDice}}" data-apply-dice-to="{{mod.applyDiceTo}}" {{#if mod.isActive}}checked{{/if}}>
        </div>
      </div>
    {{/each}}
  {{/if}}
  <h3 class="list-title">{{localize 'WOD5E.RollList.CustomModifiers'}}</h3>
  <div class="mod-row mod-header custom-mod-header">
    <div class="col-source">{{localize 'WOD5E.RollList.Source'}}</div>
    <div class="col-value">{{localize 'WOD5E.Value'}}</div>
  </div>
  <div class="custom-modifiers">
    <div id="custom-modifiers-list"></div>
  </div>
  <a class="add-custom-mod" data-action="addCustomMod">{{localize 'WOD5E.RollList.AddCustomModifier'}}</a>
</div>
