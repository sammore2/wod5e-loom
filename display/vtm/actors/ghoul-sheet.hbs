{{!-- Ghoul Sheet Header --}}
<header class="actor-header" {{#if headerbg}} style="background: url({{headerbg}}) center;"{{/if}}>
    <div class="header-fields">
        <div class="header-fields-left">
            {{!-- Health Tracker --}}
            {{> "marketplace/rulesets/wod5e/display/shared/actors/parts/health.hbs"}}
            {{!-- Willpower Tracker --}}
            {{> "marketplace/rulesets/wod5e/display/shared/actors/parts/willpower.hbs"}}
        </div>
    </div>
    <!-- Middle of the header -->
    {{> "marketplace/rulesets/wod5e/display/shared/actors/parts/header-profile.hbs"}}
    <div class="header-fields">
        <div class="header-fields-right">
            <div class="flexcol field-section">
                <span class="resource-label field-header">{{localize "WOD5E.VTM.Humanity"}}</span>
                {{> "marketplace/rulesets/wod5e/display/vtm/actors/parts/humanity.hbs"}}
            </div>
            <div class="flexcol field-section">
                <label for="ghoul-domitor" class="resource-label field-header">{{localize 'WOD5E.VTM.Domitor'}}</label>
                <input id="ghoul-domitor" name="headers.domitor" data-path="headers.domitor" type="text" value="{{domitor}}" placeholder="{{localize 'WOD5E.VTM.Domitor'}}" autocomplete="off" aria-label="{{localize 'WOD5E.VTM.Domitor'}}" />
            </div>
        </div>
    </div>
</header>
